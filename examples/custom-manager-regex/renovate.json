{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^depname-template\\.yaml$/"],
      "matchStrings": [
        ".*\\/example-org\\/example-operator\\/releases\\/download\\/(?<currentValue>v\\d+\\.\\d+\\.\\d+?)\\/.*"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "example-org/example-operator"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^depname-captured\\.yaml$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>example-org/example-tool)/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/.*\\.yml"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
